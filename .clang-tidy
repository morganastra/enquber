# Static analysis for the C++ sources. Run with:
#
#     cmake --preset lint && run-clang-tidy -p build/lint
#
# clazy covers the Qt-specific rules in the same pass (`just lint-cpp`).
# Keep this list explicit so a clang-tidy upgrade cannot silently change it.
# modernize-use-trailing-return-type is intentionally absent: it is a style
# preference, not Qt's.
Checks: >
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  modernize-use-nodiscard,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-emplace,
  modernize-return-braced-init-list
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|/)(src|tools)/'
FormatStyle: none
