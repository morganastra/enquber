# Static analysis for the C++ sources. Run with:
#
#     cmake --preset lint && run-clang-tidy -p build/lint
#
# Exclusions:
# magic-numbers: in our case this mostly flags one-off UI geometry
# literals; naming them would not really improve readability
#
# pragma-once, identifier-length, and trailing-return-type:
# checkers are contrary to Qt C++ idioms
Checks: >
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  modernize-*,
  performance-*,
  readability-*,
  portability-*,
  llvm-namespace-comment,
  misc-*,
  concurrency-*,
  -portability-avoid-pragma-once,
  -readability-identifier-length,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers
CheckOptions:
  # Qt's forwarding headers are not IWYU-clean
  misc-include-cleaner.IgnoreHeaders: 'QtCore/.*;QtGui/.*;QtWidgets/.*'
  # Qt event-handler overrides are private on purpose: narrowing is intentional,
  # only report accidental widening.
  misc-override-with-different-visibility.DisallowedVisibilityChange: widening
  readability-implicit-bool-conversion.AllowPointerConditions: true
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|/)(src|tools)/'
FormatStyle: none
