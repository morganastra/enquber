# Maintainer: Morgan Astra
pkgname=enquber-git
pkgver=0.1.1.r46.g141af06
pkgrel=1
pkgdesc="Simple QR code maker with a nice UX and near-instant startup"
arch=('x86_64')
url="https://github.com/morganastra/enquber"
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'qt6-base' 'qrencode' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'git' 'qt6-tools' 'python')
provides=('enquber')
conflicts=('enquber')
source=("enquber::git+https://github.com/morganastra/enquber.git#branch=main")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/enquber"
    # Once tags exist: v1.2.3-4-gdeadbeef -> 1.2.3.r4.gdeadbeef
    # Until then: 0.1.0.r<commit count>.g<short sha>
    local _ver
    if _ver=$(git describe --long --tags 2>/dev/null); then
        sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' <<< "$_ver"
    else
        printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
    fi
}

build() {
    cmake -S enquber -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
