# Maintainer: Morgan Astra
pkgname=enquber-git
# The real version is computed by pkgver() from the release tags; makepkg
# requires the variable to be declared, but pkgver() overwrites it at build
# time. Release tags (vX.Y.Z) mirror the version in CMakeLists.txt.
pkgver=0.1.1.r133.g6889336
pkgrel=1
pkgdesc="Simple QR code maker with a nice UX and near-instant startup"
arch=('x86_64')
url="https://github.com/morganastra/enquber"
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'qt6-base' 'qrencode' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'git' 'qt6-tools' 'python')
provides=('enquber')
conflicts=('enquber')
source=("enquber::git+https://github.com/morganastra/enquber.git#branch=main")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/enquber"
    # v1.2.3 with 4 commits on top, short sha deadbeef -> 1.2.3.r4.gdeadbeef.
    # --match keeps unrelated tags (e.g. backup/...) out of the version.
    local _ver
    if _ver=$(git describe --long --tags --match 'v*' 2>/dev/null); then
        sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' <<< "$_ver"
    else
        # No release tag reachable yet: fall back to a bare revision.
        printf "r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
    fi
}

build() {
    cmake -S enquber -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
